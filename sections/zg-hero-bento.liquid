{%- comment -%}
  Bento-grid hero: large promo tile (left), wide split tile (top right) and
  two image tiles (bottom right). Tile order = block order.
  Each tile uses its uploaded image; without one it shows a product from its
  collection on the tile colour, so it never looks empty.
  The discount-code box only renders when a code is entered.
{%- endcomment -%}

{%- style -%}
  #zgBn-{{ section.id }}, #zgBn-{{ section.id }} *, #zgBn-{{ section.id }} *::before, #zgBn-{{ section.id }} *::after { box-sizing: border-box; }
  #zgBn-{{ section.id }} { background: #EAEDF1; padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px; }
  #zgBn-{{ section.id }} .zgBn__grid {
    max-width: {{ settings.page_width | default: 1400 }}px; margin: 0 auto; display: grid; gap: 1.8rem;
    grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, clamp(230px, 22vw, 330px));
  }
  #zgBn-{{ section.id }} .zgBn__tile {
    position: relative; overflow: hidden; border-radius: 12px; background: var(--tile-bg, #0D2B5E);
    color: #fff; display: flex; isolation: isolate;
  }
  #zgBn-{{ section.id }} .zgBn__tile.is-dark { color: #0F1111; }
  #zgBn-{{ section.id }} .zgBn__tile--1 { grid-column: 1; grid-row: 1 / span 2; }
  #zgBn-{{ section.id }} .zgBn__tile--2 { grid-column: 2 / span 2; grid-row: 1; }
  #zgBn-{{ section.id }} .zgBn__tile--3 { grid-column: 2; grid-row: 2; }
  #zgBn-{{ section.id }} .zgBn__tile--4 { grid-column: 3; grid-row: 2; }

  /* media */
  #zgBn-{{ section.id }} .zgBn__photo { position: absolute; inset: 0; z-index: -2; }
  #zgBn-{{ section.id }} .zgBn__photo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  #zgBn-{{ section.id }} .zgBn__tile:hover .zgBn__photo img { transform: scale(1.04); }
  #zgBn-{{ section.id }} .zgBn__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.12) 55%, rgba(0,0,0,0) 100%); }
  #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__shade { background: linear-gradient(to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 55%, rgba(0,0,0,0) 100%); }
  #zgBn-{{ section.id }} .zgBn__prod {
    position: absolute; z-index: -1; background: #fff; border-radius: 16px; box-shadow: 0 18px 40px rgba(0,0,0,0.25);
    display: flex; align-items: center; justify-content: center; overflow: hidden; transition: transform 0.4s ease; box-sizing: border-box;
  }
  #zgBn-{{ section.id }} .zgBn__prod img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #zgBn-{{ section.id }} .zgBn__tile:hover .zgBn__prod { transform: translateY(-4px) rotate(-1deg); }
  #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__prod { right: 6%; top: 8%; width: 36%; aspect-ratio: 1 / 1; padding: 2.4rem; }
  #zgBn-{{ section.id }} .zgBn__tile--3 .zgBn__prod,
  #zgBn-{{ section.id }} .zgBn__tile--4 .zgBn__prod { right: 8%; top: 9%; width: 46%; aspect-ratio: 1 / 1; padding: 1.2rem; }

  /* split tile (2) */
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__content { width: 52%; }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__side { position: absolute; top: 0; right: 0; bottom: 0; width: 48%; z-index: -1; }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__side img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__side--prod { display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__side--prod span { width: 66%; aspect-ratio: 1 / 1; background: #fff; border-radius: 16px; padding: 1.6rem; box-shadow: 0 18px 40px rgba(0,0,0,0.25); display: flex; }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__side--prod img { object-fit: contain; }

  /* content */
  #zgBn-{{ section.id }} .zgBn__content { position: relative; display: flex; flex-direction: column; align-items: flex-start; padding: 3.2rem; width: 100%; gap: 1.2rem; }
  #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__content { justify-content: flex-end; max-width: 78%; padding: 4.4rem; }
  #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__badge { margin-bottom: auto; }
  #zgBn-{{ section.id }} .zgBn__tile--3 .zgBn__content,
  #zgBn-{{ section.id }} .zgBn__tile--4 .zgBn__content { justify-content: flex-end; padding: 2.2rem; gap: 0.8rem; }
  #zgBn-{{ section.id }} .zgBn__badge { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 1.35rem; padding: 0.4rem 1rem; border-radius: 5px; line-height: 1.3; }
  #zgBn-{{ section.id }} .zgBn__badge--red { background: #E11D48; color: #fff; }
  #zgBn-{{ section.id }} .zgBn__badge--gold { background: #C49A3A; color: #0A1F44; }
  #zgBn-{{ section.id }} .zgBn__badge--blue { background: #2563EB; color: #fff; }
  #zgBn-{{ section.id }} .zgBn__heading { margin: 0; color: inherit; font-weight: 800; line-height: 1.05; letter-spacing: -0.01em; }
  #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__heading { font-size: clamp(3.2rem, 3.5vw, 5.2rem); }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__heading { font-size: clamp(2.4rem, 2.4vw, 3.4rem); }
  #zgBn-{{ section.id }} .zgBn__tile--3 .zgBn__heading,
  #zgBn-{{ section.id }} .zgBn__tile--4 .zgBn__heading { font-size: clamp(1.9rem, 1.8vw, 2.6rem); }
  #zgBn-{{ section.id }} .zgBn__text { margin: 0; font-size: 1.7rem; line-height: 1.45; opacity: 0.92; max-width: 42ch; }
  #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__btn { margin-top: auto; }
  #zgBn-{{ section.id }} .zgBn__actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
  #zgBn-{{ section.id }} .zgBn__btn { display: inline-flex; align-items: center; justify-content: center; background: #C49A3A; color: #0A1F44; font-weight: 700; font-size: 1.7rem; padding: 1.3rem 2.8rem; border-radius: 8px; text-decoration: none; transition: background 0.15s, transform 0.15s; }
  #zgBn-{{ section.id }} .zgBn__btn:hover { background: #D9B256; transform: translateY(-1px); }
  #zgBn-{{ section.id }} .zgBn__code {
    display: inline-flex; align-items: center; justify-content: space-between; gap: 2.4rem; min-width: 22rem;
    background: #fff; color: #0D2B5E; border: 0; border-radius: 8px; padding: 1.2rem 1.6rem; font-weight: 800; font-size: 1.7rem;
    letter-spacing: 0.04em; cursor: pointer; font-family: inherit;
  }
  #zgBn-{{ section.id }} .zgBn__code svg { width: 22px; height: 22px; flex: 0 0 auto; }
  #zgBn-{{ section.id }} .zgBn__code.is-copied { background: #DCFCE7; color: #166534; }
  #zgBn-{{ section.id }} .zgBn__cover { position: absolute; inset: 0; z-index: 1; }
  #zgBn-{{ section.id }} .zgBn__cover:focus-visible { outline: 3px solid #C49A3A; outline-offset: -3px; border-radius: 12px; }

  @media screen and (max-width: 989px) {
    #zgBn-{{ section.id }} .zgBn__grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto; }
    #zgBn-{{ section.id }} .zgBn__tile--1 { grid-column: 1 / span 2; grid-row: auto; min-height: 460px; }
    #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__prod { width: 30%; top: 7%; }
    #zgBn-{{ section.id }} .zgBn__tile--2 { grid-column: 1 / span 2; grid-row: auto; min-height: 260px; }
    #zgBn-{{ section.id }} .zgBn__tile--3, #zgBn-{{ section.id }} .zgBn__tile--4 { grid-column: auto; grid-row: auto; min-height: 260px; }
  }
  @media screen and (max-width: 749px) {
    #zgBn-{{ section.id }} { padding-left: 1rem; padding-right: 1rem; }
    #zgBn-{{ section.id }} .zgBn__grid { gap: 1rem; }
    #zgBn-{{ section.id }} .zgBn__tile--1 { min-height: 560px; }
    #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__content { max-width: 100%; padding: 2.4rem 2rem; }
    #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__prod { right: 50%; top: 9%; width: 46%; translate: 50% 0; padding: 1.6rem; }
    #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__shade { background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0) 100%); }
    #zgBn-{{ section.id }} .zgBn__actions { width: 100%; flex-direction: column; }
    #zgBn-{{ section.id }} .zgBn__code, #zgBn-{{ section.id }} .zgBn__tile--1 .zgBn__btn { width: 100%; }
    #zgBn-{{ section.id }} .zgBn__tile--2 { min-height: 0; }
    #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__content { width: 58%; padding: 2rem; }
    #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__side { width: 42%; }
    #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__text { font-size: 1.4rem; }
    #zgBn-{{ section.id }} .zgBn__tile--2 .zgBn__btn { font-size: 1.5rem; padding: 1rem 1.8rem; margin-top: 0.6rem; }
    #zgBn-{{ section.id }} .zgBn__tile--3, #zgBn-{{ section.id }} .zgBn__tile--4 { min-height: 220px; }
    #zgBn-{{ section.id }} .zgBn__tile--3 .zgBn__content, #zgBn-{{ section.id }} .zgBn__tile--4 .zgBn__content { padding: 1.4rem; }
    #zgBn-{{ section.id }} .zgBn__badge { font-size: 1.2rem; }
  }
{%- endstyle -%}

<div id="zgBn-{{ section.id }}" class="zgBn">
  <div class="zgBn__grid">
    {%- for block in section.blocks limit: 4 -%}
      {%- liquid
        assign pos = forloop.index
        assign c = block.settings.collection
        if c == blank and block.settings.handle != blank
          assign c = collections[block.settings.handle]
        endif
        assign href = block.settings.link
        if href == blank and c != blank
          assign href = c.url
        endif
        if href == blank
          assign href = routes.all_products_collection_url
        endif
        assign prod = nil
        if c != blank
          for p in c.products limit: 6
            if p.featured_media
              assign prod = p
              break
            endif
          endfor
        endif
        assign img = block.settings.image
        assign heading_tag = 'h3'
        if pos == 1
          assign heading_tag = 'h2'
        endif
      -%}
      <div
        class="zgBn__tile zgBn__tile--{{ pos }}{% if block.settings.text_color == 'dark' %} is-dark{% endif %}"
        style="--tile-bg: {{ block.settings.bg }};"
        {{ block.shopify_attributes }}
      >
        {%- if pos == 2 -%}
          {%- if img != blank -%}
            <span class="zgBn__side">{{ img | image_url: width: 1000 | image_tag: loading: 'eager', widths: '500, 750, 1000', sizes: '(min-width: 990px) 25vw, 45vw', alt: img.alt | default: block.settings.heading }}</span>
          {%- elsif prod != blank -%}
            <span class="zgBn__side zgBn__side--prod"><span>{{ prod.featured_media | image_url: width: 500 | image_tag: loading: 'eager', alt: prod.title }}</span></span>
          {%- endif -%}
        {%- elsif img != blank -%}
          <span class="zgBn__photo">
            {%- if pos == 1 -%}
              {{ img | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', alt: img.alt | default: block.settings.heading }}
            {%- else -%}
              {{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: img.alt | default: block.settings.heading }}
            {%- endif -%}
          </span>
          <span class="zgBn__shade"></span>
        {%- elsif prod != blank -%}
          <span class="zgBn__prod">{{ prod.featured_media | image_url: width: 700 | image_tag: loading: 'eager', alt: prod.title }}</span>
        {%- endif -%}

        <div class="zgBn__content">
          {%- if block.settings.badge != blank -%}
            <span class="zgBn__badge zgBn__badge--{{ block.settings.badge_style }}">{{ block.settings.badge }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <{{ heading_tag }} class="zgBn__heading">{{ block.settings.heading }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if block.settings.text != blank and pos < 3 -%}
            <p class="zgBn__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if pos < 3 -%}
            {%- if pos == 1 -%}<div class="zgBn__actions">{%- endif -%}
            {%- if block.settings.code != blank -%}
              <button type="button" class="zgBn__code" data-zg-code="{{ block.settings.code | escape }}" aria-label="Copy code {{ block.settings.code | escape }}">
                <span data-zg-code-label>{{ block.settings.code }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
              </button>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="zgBn__btn" href="{{ href }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
            {%- if pos == 1 -%}</div>{%- endif -%}
          {%- endif -%}
        </div>

        {%- if pos > 2 -%}
          <a class="zgBn__cover" href="{{ href }}"><span class="visually-hidden">{{ block.settings.heading | default: c.title }}</span></a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('zgBn-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('[data-zg-code]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var code = btn.dataset.zgCode, label = btn.querySelector('[data-zg-code-label]');
        var done = function () {
          btn.classList.add('is-copied'); label.textContent = 'Copied!';
          setTimeout(function () { btn.classList.remove('is-copied'); label.textContent = code; }, 1600);
        };
        if (navigator.clipboard) { navigator.clipboard.writeText(code).then(done, done); } else { done(); }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "ZGlobal hero (bento)",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "Block 1 = large left tile, 2 = wide top-right, 3 and 4 = small bottom-right." },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Without an image, a product from the collection is shown." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "handle", "label": "Collection handle (fallback)" },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection." },
        { "type": "text", "id": "badge", "label": "Badge" },
        {
          "type": "select", "id": "badge_style", "label": "Badge colour", "default": "red",
          "options": [ { "value": "red", "label": "Red" }, { "value": "gold", "label": "Gold" }, { "value": "blue", "label": "Blue" } ]
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "text", "label": "Text", "info": "Shown on tiles 1 and 2." },
        { "type": "text", "id": "code", "label": "Discount code", "info": "Optional. Shows a tap-to-copy code box. Use a real code from Shopify Discounts." },
        { "type": "text", "id": "button_label", "label": "Button label", "info": "Shown on tiles 1 and 2." },
        { "type": "color", "id": "bg", "label": "Background colour", "default": "#0D2B5E" },
        {
          "type": "select", "id": "text_color", "label": "Text colour", "default": "light",
          "options": [ { "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" } ]
        }
      ]
    }
  ],
  "presets": [
    { "name": "ZGlobal hero (bento)", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] }
  ]
}
{% endschema %}
