{%- liquid
  assign btn1_link = section.settings.button_link_1
  if btn1_link == blank
    assign btn1_link = routes.all_products_collection_url
  endif
  assign btn2_link = section.settings.button_link_2
  if btn2_link == blank
    assign btn2_link = routes.all_products_collection_url
  endif
  assign hero_eyebrow = section.settings.eyebrow | default: 'ZGlobal Store'
  assign hero_heading = section.settings.heading | default: 'Beauty, outdoor & home — delivered'
  assign hero_text = section.settings.text | default: 'Shop trusted brands at everyday prices. Fast shipping across Europe.'
  assign hero_btn1 = section.settings.button_label_1 | default: 'Shop new arrivals'
  assign hero_btn2 = section.settings.button_label_2 | default: 'Browse all'
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
    assign bg_url = section.settings.image | image_url: width: 2400
  endif
-%}

{%- style -%}
  #zgHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    color: #FFFFFF;
    background-color: #0D2B5E;
    {% if has_image %}
      background-image: linear-gradient(to right, rgba(6,18,46,0.72) 0%, rgba(10,31,68,0.45) 60%, rgba(10,31,68,0.30) 100%), url('{{ bg_url }}');
      background-size: cover;
      background-position: center;
    {% else %}
      background-image:
        radial-gradient(1100px 600px at 88% -10%, rgba(196,154,58,0.20), transparent 60%),
        linear-gradient(135deg, #0A1F44 0%, #0D2B5E 55%, #123A7A 100%);
    {% endif %}
  }
  #zgHero-{{ section.id }} .zgHero__inner {
    position: relative;
    z-index: 1;
    max-width: {{ settings.page_width | default: 1400 }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_vertical }}px 50px;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 40px;
  }
  #zgHero-{{ section.id }} .zgHero__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
    text-align: {{ section.settings.alignment }};
    align-items: {% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #zgHero-{{ section.id }} .zgHero__eyebrow {
    text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.78rem;
    color: #C49A3A; font-weight: 600; margin: 0;
  }
  #zgHero-{{ section.id }} .zgHero__title {
    font-size: clamp(2.1rem, 4.6vw, 3.6rem); line-height: 1.08; margin: 0; color: #FFFFFF;
  }
  #zgHero-{{ section.id }} .zgHero__text {
    font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.5; margin: 0;
    color: rgba(255,255,255,0.85); max-width: 46ch;
  }
  #zgHero-{{ section.id }} .zgHero__buttons { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  #zgHero-{{ section.id }} .zgHero__btn {
    display: inline-block; padding: 14px 30px; border-radius: 6px; font-weight: 600;
    text-decoration: none; transition: transform 0.15s ease; font-size: 1rem;
  }
  #zgHero-{{ section.id }} .zgHero__btn:hover { transform: translateY(-2px); }
  #zgHero-{{ section.id }} .zgHero__btn--primary { background: #C49A3A; color: #0D2B5E; }
  #zgHero-{{ section.id }} .zgHero__btn--secondary { background: transparent; color: #FFFFFF; border: 1.5px solid rgba(255,255,255,0.6); }
  #zgHero-{{ section.id }} .zgHero__btn--secondary:hover { border-color: #FFFFFF; }

  /* Rotating globe */
  #zgHero-{{ section.id }} .zgHero__visual { display: flex; justify-content: center; align-items: center; }
  #zgHero-{{ section.id }} .zgHero__globe {
    position: relative;
    width: clamp(220px, 30vw, 400px);
    aspect-ratio: 1 / 1;
  }
  #zgHero-{{ section.id }} .zgHero__orbit { display: block;
    position: absolute; left: -9%; right: -9%; top: 50%;
    height: 34%; transform: translateY(-50%) rotate(-18deg);
    border: 1.5px solid rgba(196,154,58,0.55); border-radius: 50%;
    pointer-events: none;
  }
  #zgHero-{{ section.id }} .zgHero__sphere { display: block;
    position: absolute; inset: 0; border-radius: 50%; overflow: hidden;
    background:
      radial-gradient(circle at 32% 26%, rgba(255,255,255,0.38) 0%, rgba(255,255,255,0.10) 18%, transparent 44%),
      repeating-linear-gradient(0deg, transparent 0 28px, rgba(255,255,255,0.10) 28px 29px),
      radial-gradient(circle at 50% 42%, #1A4A95 0%, #0E2E64 58%, #081B3C 100%);
    box-shadow:
      inset -26px -26px 70px rgba(0,0,0,0.60),
      inset 14px 14px 46px rgba(255,255,255,0.06),
      0 30px 70px rgba(0,0,0,0.45);
  }
  #zgHero-{{ section.id }} .zgHero__sphere::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    background: repeating-linear-gradient(90deg, rgba(196,154,58,0) 0 30px, rgba(196,154,58,0.32) 30px 32px);
    animation: zgMerid-{{ section.id }} 6s linear infinite;
    -webkit-mask: radial-gradient(circle at 50% 50%, #000 70%, transparent 100%);
    mask: radial-gradient(circle at 50% 50%, #000 70%, transparent 100%);
  }
  #zgHero-{{ section.id }} .zgHero__globe:hover .zgHero__sphere::after { animation-duration: 1.1s; }
  @keyframes zgMerid-{{ section.id }} { to { background-position-x: 32px; } }

  @media screen and (max-width: 989px) {
    #zgHero-{{ section.id }} .zgHero__inner {
      grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 28px;
      padding-left: 20px; padding-right: 20px;
    }
    #zgHero-{{ section.id }} .zgHero__content { text-align: center; align-items: center; order: 2; }
    #zgHero-{{ section.id }} .zgHero__visual { order: 1; }
    #zgHero-{{ section.id }} .zgHero__globe { width: clamp(180px, 60vw, 260px); }
    #zgHero-{{ section.id }} .zgHero__text { max-width: 54ch; }
  }
  @media (prefers-reduced-motion: reduce) {
    #zgHero-{{ section.id }} .zgHero__sphere::after { animation: none; }
  }
{%- endstyle -%}

<section id="zgHero-{{ section.id }}" class="zgHero">
  <div class="zgHero__inner">
    <div class="zgHero__content">
      <p class="zgHero__eyebrow">{{ hero_eyebrow }}</p>
      <h1 class="zgHero__title">{{ hero_heading }}</h1>
      <p class="zgHero__text">{{ hero_text }}</p>
      <div class="zgHero__buttons">
        <a class="zgHero__btn zgHero__btn--primary" href="{{ btn1_link }}">{{ hero_btn1 }}</a>
        <a class="zgHero__btn zgHero__btn--secondary" href="{{ btn2_link }}">{{ hero_btn2 }}</a>
      </div>
    </div>
    <div class="zgHero__visual" aria-hidden="true">
      <div class="zgHero__globe">
        <div class="zgHero__orbit"></div>
        <div class="zgHero__sphere"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZGlobal hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Optional. Leave empty to use the navy gradient with the rotating globe." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ZGlobal Store" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Beauty, outdoor & home — delivered" },
    { "type": "text", "id": "text", "label": "Subheading", "default": "Shop trusted brands at everyday prices. Fast shipping across Europe." },
    { "type": "range", "id": "padding_vertical", "label": "Vertical padding", "min": 60, "max": 200, "step": 10, "unit": "px", "default": 120 },
    {
      "type": "select", "id": "alignment", "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "button_label_1", "label": "Label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link_1", "label": "Link" },
    { "type": "header", "content": "Secondary button" },
    { "type": "text", "id": "button_label_2", "label": "Label", "default": "Browse all" },
    { "type": "url", "id": "button_link_2", "label": "Link" }
  ],
  "presets": [
    { "name": "ZGlobal hero" }
  ]
}
{% endschema %}
