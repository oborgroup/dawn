{%- liquid
  assign btn1_link = section.settings.button_link_1
  if btn1_link == blank
    assign btn1_link = routes.all_products_collection_url
  endif
  assign btn2_link = section.settings.button_link_2

  if section.settings.image != blank
    assign bg_url = section.settings.image | image_url: width: 2400
  else
    assign bg_url = 'hero-bg.jpg' | asset_url
  endif
-%}

{%- style -%}
  #zgHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: #0D2B5E;
    background-image:
      linear-gradient(to right, rgba(6,18,46,0.70) 0%, rgba(10,31,68,0.45) 45%, rgba(10,31,68,0.30) 100%),
      url('{{ bg_url }}');
    background-size: cover;
    background-position: center;
    color: #FFFFFF;
  }
  #zgHero-{{ section.id }} .zgHero__inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: {{ section.settings.padding_vertical }}px 24px;
    text-align: {{ section.settings.alignment }};
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: {% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
  #zgHero-{{ section.id }} .zgHero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    color: #C49A3A;
    font-weight: 600;
    margin: 0;
  }
  #zgHero-{{ section.id }} .zgHero__title {
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.08;
    margin: 0;
    color: #FFFFFF;
  }
  #zgHero-{{ section.id }} .zgHero__text {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.5;
    margin: 0;
    color: rgba(255,255,255,0.85);
    max-width: 52ch;
  }
  #zgHero-{{ section.id }} .zgHero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }
  #zgHero-{{ section.id }} .zgHero__btn {
    display: inline-block;
    padding: 14px 30px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
    font-size: 1rem;
  }
  #zgHero-{{ section.id }} .zgHero__btn:hover { transform: translateY(-2px); }
  #zgHero-{{ section.id }} .zgHero__btn--primary {
    background: #C49A3A;
    color: #0D2B5E;
  }
  #zgHero-{{ section.id }} .zgHero__btn--secondary {
    background: transparent;
    color: #FFFFFF;
    border: 1.5px solid rgba(255,255,255,0.6);
  }
  #zgHero-{{ section.id }} .zgHero__btn--secondary:hover { border-color: #FFFFFF; }
  @media screen and (max-width: 749px) {
    #zgHero-{{ section.id }} .zgHero__inner { padding-left: 20px; padding-right: 20px; }
  }
{%- endstyle -%}

<section id="zgHero-{{ section.id }}" class="zgHero">
  <div class="zgHero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zgHero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="zgHero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="zgHero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="zgHero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="zgHero__btn zgHero__btn--primary" href="{{ btn1_link }}">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank and btn2_link != blank -%}
          <a class="zgHero__btn zgHero__btn--secondary" href="{{ btn2_link }}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ZGlobal hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Optional. Leave empty to use the built-in ZGlobal gradient banner." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ZGlobal Store" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Beauty, outdoor & home — delivered" },
    { "type": "text", "id": "text", "label": "Subheading", "default": "Shop trusted brands at everyday prices. Fast shipping across Europe." },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Primary button" },
    { "type": "text", "id": "button_label_1", "label": "Label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link_1", "label": "Link" },
    { "type": "header", "content": "Secondary button" },
    { "type": "text", "id": "button_label_2", "label": "Label", "default": "Browse all" },
    { "type": "url", "id": "button_link_2", "label": "Link" }
  ],
  "presets": [
    { "name": "ZGlobal hero" }
  ]
}
{% endschema %}
